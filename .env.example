VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publica"
# Metade pública do par de chaves VAPID (gere com `npx web-push generate-vapid-keys`).
# A privada NÃO vai aqui — é secret só da edge function send-push.
VITE_VAPID_PUBLIC_KEY="sua-chave-publica-vapid"
# Opcional: preencha após publicar um APK Android release assinado.
# Sem esta URL, Android usa a instalação web; iPhone usa o Safari.
# Vazio mantém a instalação pelo navegador sem exibir links de download inexistentes.
VITE_ANDROID_APK_URL=""
