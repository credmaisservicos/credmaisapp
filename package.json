{
  "name": "credmaisapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:apk": "node scripts/build-apk.mjs",
    "mobile:release": "node scripts/build-apk.mjs --release",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm run lint && npm run check:hooks && npm run check:functions && npm run test:functions && npm run test && npm run build",
    "check:hooks": "node scripts/checar-hooks.mjs",
    "check:functions": "node scripts/checar-funcoes.mjs",
    "test:functions": "node scripts/testar-funcoes.mjs",
    "test:integrations": "node scripts/testar-integracoes.mjs",
    "test:release": "node --test scripts/web-release-catalog.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern backups --max-warnings 0",
    "audit": "npm audit --audit-level=low",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run deploy:cloudflare:pages",
    "deploy:cloudflare:pages": "node scripts/deploy-app.mjs pages",
    "deploy:cloudflare:worker": "node scripts/deploy-app.mjs worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/testar-interface.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lenis": "^1.3.25",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.3.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
